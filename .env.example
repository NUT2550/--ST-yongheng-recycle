# Environment variables — copy to .env and fill with REAL values.
# NEVER commit real credentials. This file contains PLACEHOLDERS ONLY.

# Database (Supabase Production pooler)
SUPABASE_POOLER_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@pooler-host:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@db-host:5432/postgres
DIRECT_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@db-host:5432/postgres

# Auth
JWT_SECRET=generate-a-random-secret-at-least-32-chars

# Reconciliation scripts (optional, for local dev)
SUPABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@pooler-host:6543/postgres?pgbouncer=true&connection_limit=1
